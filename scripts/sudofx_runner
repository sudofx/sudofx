#!/usr/bin/env bash
# Operate the local sudofx development container without changing hosted state.
# The named container and home volume belong only to this repository's dev setup.
# Source, .env, Git history, and SQLite records stay in the writable host checkout.
# Git credentials are supplied ephemerally by the attached VS Code session.

usage() {
    cat <<'EOF'
Usage: ./scripts/sudofx_runner {start|stop|reset|--reset}

start  Build the development image if needed, then create or start sudofx.app.
stop   Stop sudofx.app while preserving the checkout and container home.
reset  Recreate sudofx.app and clear only its disposable home volume.
--reset Alias for reset, matching the WAKE runner convention.

The repository is mounted read/write at /workspace and .env is loaded into the
container process environment. Reset does not delete files in this checkout.
EOF
}

main() {
    local action="${1:-}"
    local repo_dir=""
    local image="sudofx-dev:local"
    local container="sudofx.app"
    local home_volume="sudofx.app-home"
    local dotenv_line dotenv_name proxy_url
    local -a mounts runtime_env

    if [[ "$#" -ne 1 ]]; then
        usage >&2
        return 2
    fi
    case "$action" in
        start|stop|reset|--reset) ;;
        -h|--help) usage; return 0 ;;
        *) usage >&2; return 2 ;;
    esac

    repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)" || return
    [[ -f "$repo_dir/.env" ]] || {
        echo "Missing local .env in $repo_dir; copy .env.example and add credentials." >&2
        return 1
    }
    docker info >/dev/null 2>&1 || {
        echo "Docker is unavailable. Start Docker first." >&2
        return 1
    }

    if [[ "$action" == stop ]]; then
        if docker container inspect "$container" >/dev/null 2>&1; then
            docker stop "$container"
        else
            echo "$container is not present."
        fi
        return
    fi

    if [[ "$action" == --reset ]]; then
        action="reset"
    fi

    if [[ "$action" == reset ]]; then
        # Remove the container before its home volume; neither owns repo data.
        if docker container inspect "$container" >/dev/null 2>&1; then
            docker rm -f "$container" || return
        fi
        if docker volume inspect "$home_volume" >/dev/null 2>&1; then
            docker volume rm "$home_volume" || return
        fi
    elif docker container inspect "$container" >/dev/null 2>&1; then
        if [[ "$(docker inspect -f '{{.State.Running}}' "$container")" == true ]]; then
            echo "$container is already running."
            return 0
        fi
        docker start "$container"
        return
    fi

    # Docker's --env-file retains surrounding quotes, while Bash correctly
    # removes them from this repo's shell-compatible .env. Pass only its
    # declared names through Docker so credentials never become image layers.
    while IFS= read -r dotenv_line || [[ -n "$dotenv_line" ]]; do
        [[ "$dotenv_line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)= ]] || continue
        dotenv_name="${BASH_REMATCH[2]}"
        [[ "$dotenv_name" == HTTP_PROXY || "$dotenv_name" == HTTPS_PROXY ]] && continue
        runtime_env+=(--env "$dotenv_name")
    done < "$repo_dir/.env"
    set -a
    # shellcheck disable=SC1090
    source "$repo_dir/.env"
    set +a

    # Docker Desktop's VM may require its host bridge proxy to reach Debian.
    # Gemini's HTTPS calls need the same route at runtime as image package pulls.
    proxy_url="${HTTPS_PROXY:-${HTTP_PROXY:-http://http.docker.internal:3128}}"
    docker build --build-arg "HTTPS_PROXY=$proxy_url" \
        -t "$image" "$repo_dir" || return
    docker volume create "$home_volume" >/dev/null || return
    mounts=(--mount "type=bind,src=$repo_dir,dst=/workspace"
            --mount "type=volume,src=$home_volume,dst=/home/sudofx")
    runtime_env+=(--env "HTTPS_PROXY=$proxy_url" --env "HTTP_PROXY=$proxy_url")
    # Keep VS Code's server/extension cache across the move from root to sudofx.
    # Its credential helper remains a live VS Code bridge; no host key is copied.
    docker run --rm --user root \
        --mount "type=volume,src=$home_volume,dst=/home/sudofx" \
        "$image" sh -c 'if [ ! -f /home/sudofx/.owner-10001 ]; then chown -R 10001:10001 /home/sudofx && touch /home/sudofx/.owner-10001 && chown 10001:10001 /home/sudofx/.owner-10001; fi' || return
    docker run -d \
        --name "$container" \
        --restart unless-stopped \
        -p "127.0.0.1:${SUDOFX_CONVERSATION_PORT:-8765}:8765" \
        "${mounts[@]}" \
        --workdir /workspace \
        "${runtime_env[@]}" \
        -e HOME=/home/sudofx \
        "$image"
}

main "$@"
