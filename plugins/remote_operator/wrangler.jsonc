{
  // Human-editable deployment configuration for the remote_operator plugin.
  // Secrets remain in Cloudflare's encrypted secret store, never this file.
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sudofx-control",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-26",
  "vars": {
    "OWNER_GITHUB_ID": "14032554",
    "PAGES_URL": "https://sudofx.github.io/sudofx/",
    "REPOSITORY": "sudofx/sudofx",

    // Comma-separated subset of the plugin's compiled capability ceiling.
    // Unknown names are ignored; configuration can remove authority, not add it.
    "ENABLED_CAPABILITIES": "start,stop,backup,verify,prove-work,prove-model,export-handoff,handoff-evaluate,storage-diagnostics"
  }
}
