{
  "name": "sudofx Conversation",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "sudofx",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "sudofx Conversation",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postStartCommand": "bash .devcontainer/start-conversation.sh",
  "secrets": {
    "GEMINI_API_KEY": {
      "description": "Gemini API key used only inside the private Conversation Codespace for fresh provider invocations."
    }
  }
}
