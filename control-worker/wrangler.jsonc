{
  // The Worker is intentionally dependency-free. Secrets are installed through
  // the provider's encrypted secret store and never committed beside this file.
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sudofx-control",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-26",
  "vars": {
    "OWNER_GITHUB_ID": "14032554",
    "PAGES_URL": "https://sudofx.github.io/sudofx/",
    "REPOSITORY": "sudofx/sudofx"
  }
}
